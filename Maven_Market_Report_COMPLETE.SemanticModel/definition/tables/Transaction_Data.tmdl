		sourceColumn: customer_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: aa74c810-7412-4632-bc09-9c7d1f2dae99
		summarizeBy: none
		sourceColumn: store_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column quantity
		dataType: int64
		formatString: 0
		lineageTag: 60b72eba-15b0-4d85-9372-490fb977ece5
		summarizeBy: sum
		sourceColumn: quantity

